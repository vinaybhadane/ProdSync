# ============================================================
# ProdSync Backend — Environment Configuration (.env.example)
# ============================================================

# App Settings
APP_NAME=ProdSync
APP_ENV=development
API_V1_STR=/api/v1
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","https://prodsync.ai"]

# Firebase Authentication (Server Verification)
FIREBASE_PROJECT_ID=prodsync06
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CREDENTIALS_PATH=

# PostgreSQL Database (Azure Database for PostgreSQL or local/SQLite)
DATABASE_URL=sqlite+aiosqlite:///./prodsync.db
# Example for Azure PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@prodsync-pg.postgres.database.azure.com:5432/prodsync?ssl=require

# Azure Storage (Blob)
AZURE_STORAGE_ACCOUNT_NAME=prodsyncstorage
AZURE_STORAGE_CONTAINER_RAW=prod-sync-raw
AZURE_STORAGE_CONTAINER_PROCESSED=prod-sync-processed
AZURE_STORAGE_CONTAINER_EXPORTS=prod-sync-exports
AZURE_STORAGE_CONNECTION_STRING=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://prodsync-openai.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Azure AI Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://prodsync-doc-intel.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=

# Azure Service Bus
AZURE_SERVICE_BUS_NAMESPACE=prodsync-bus.servicebus.windows.net
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_QUEUE_PROCESSING=document-processing

# Azure Application Insights / Telemetry
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Security & Rate Limiting
SECRET_KEY=super-secret-key-change-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_MB=25
