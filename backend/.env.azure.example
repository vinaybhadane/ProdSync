# ============================================================
# ProdSync Backend — Azure Environment Configuration
# Use this as a reference for setting env vars in:
#   - Azure Container Apps (portal or CLI)
#   - GitHub Actions secrets
#   - Azure Key Vault
# ============================================================

# ── App Settings ─────────────────────────────────────────────
APP_NAME=ProdSync
APP_ENV=production
API_V1_STR=/api/v1
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Update with your actual Azure Static Web Apps URL after first deploy:
CORS_ORIGINS=["https://YOUR-APP.azurestaticapps.net","https://prodsync.ai"]

# ── Firebase Authentication ───────────────────────────────────
FIREBASE_PROJECT_ID=prodsync06
# Store the full JSON content (single line) in Azure Key Vault as 'firebase-service-account-json'
# Then reference it here or load it from Key Vault in code:
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── PostgreSQL (Azure Database for PostgreSQL Flexible Server) ─
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB?ssl=require
DATABASE_URL=postgresql+asyncpg://prodsyncadmin:YOUR_PASSWORD@prodsync-production-pg.postgres.database.azure.com:5432/prodsync?ssl=require

# ── Azure Blob Storage ────────────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=prodsyncstproduction
AZURE_STORAGE_CONTAINER_RAW=prod-sync-raw
AZURE_STORAGE_CONTAINER_PROCESSED=prod-sync-processed
AZURE_STORAGE_CONTAINER_EXPORTS=prod-sync-exports
# Get from Azure Portal → Storage Account → Access Keys:
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# ── Azure OpenAI ──────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://prodsync-openai.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── Azure Document Intelligence ───────────────────────────────
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://prodsync-doc-intel.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=

# ── Azure Service Bus ─────────────────────────────────────────
AZURE_SERVICE_BUS_NAMESPACE=prodsync-production-bus.servicebus.windows.net
# Get from Azure Portal → Service Bus → Shared Access Policies → RootManageSharedAccessKey:
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_QUEUE_PROCESSING=document-processing

# ── Azure Application Insights ────────────────────────────────
# Get from Azure Portal → Application Insights → Overview → Connection String:
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# ── Azure Key Vault ───────────────────────────────────────────
AZURE_KEY_VAULT_URL=https://prodsync-production-kv.vault.azure.net/

# ── Google Gemini AI ──────────────────────────────────────────
GEMINI_API_KEY=

# ── Security & Rate Limiting ──────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_MB=25
